// sweam controller mapping — default layout with the right pad back in
// absolute mode: the touch *position* maps straight to right-stick
// deflection (Steam's "joystick_move"), instead of the default camera
// mode where finger motion drives the stick. Absolute mode gives a
// stick-like, self-centering pad — no drift, but only as much range as
// the pad is wide. Full schema reference: src/steam/config.rs. Run with:
//   sweam steam --config configs/absolute-rightpad.vdf
"controller_mappings"
{
	"version"		"1"
	"title"			"Absolute right pad"
	"description"	"Default layout, but the right-pad touch position maps to the right stick absolutely (stick-like) instead of driving it as a velocity-based camera."

	"group"
	{
		"source"	"button_diamond"
		"bindings"
		{
			// Steam uses the Xbox layout (A bottom, B right, X left, Y top);
			// Switch puts B bottom, A right, Y left, X top → swap to keep
			// physical positions.
			"button_a"	"switch_button B"
			"button_b"	"switch_button A"
			"button_x"	"switch_button Y"
			"button_y"	"switch_button X"
		}
	}

	"group"
	{
		"source"	"switch"
		"bindings"
		{
			"left_bumper"		"switch_button L"
			"right_bumper"		"switch_button R"
			"button_escape"		"switch_button MINUS"	// left menu (back)
			"button_menu"		"switch_button PLUS"	// right menu (start)
			"button_steam"		"switch_button HOME"	// Steam logo
			"button_back_left"	"switch_button CAPTURE"	// left grip lever
			"button_back_right"	"switch_button HOME"	// right grip lever
		}
	}

	"group"
	{
		"source"	"left_trigger"
		"mode"		"trigger"
		"bindings"
		{
			"click"	"switch_button ZL"	// full pull
		}
	}

	"group"
	{
		"source"	"right_trigger"
		"mode"		"trigger"
		"bindings"
		{
			"click"	"switch_button ZR"
		}
	}

	"group"
	{
		"source"	"joystick"
		"mode"		"joystick_move"
		"bindings"
		{
			"click"	"switch_button LSTICK"
		}
		"settings"
		{
			"output_joystick"	"left"
		}
	}

	"group"
	{
		"source"	"left_trackpad"
		"mode"		"dpad"
		"bindings"
		{
			"dpad_north"	"switch_button DPAD_UP"
			"dpad_south"	"switch_button DPAD_DOWN"
			"dpad_west"		"switch_button DPAD_LEFT"
			"dpad_east"		"switch_button DPAD_RIGHT"
		}
	}

	"group"
	{
		"source"	"right_trackpad"
		"mode"		"joystick_move"	// touch position → stick (vs joystick_camera)
		"bindings"
		{
			"click"	"switch_button RSTICK"
		}
		"settings"
		{
			"output_joystick"	"right"
		}
	}
}
