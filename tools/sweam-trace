#!/bin/sh
# Record gadget-side USB events into the ftrace ring buffer.
#   sweam-trace start  — begin recording (survives sweam restarts)
#   sweam-trace dump   — print what the buffer still holds
# The buffer is a ring, so after a disconnect it holds the events leading
# up to it, which is the part we cannot see from sweam logs alone.
T=/sys/kernel/debug/tracing
case "$1" in
start)
  echo 0 > $T/tracing_on
  : > $T/trace
  echo 16384 > $T/buffer_size_kb
  for e in dwc3/dwc3_event dwc3/dwc3_ctrl_req dwc3/dwc3_gadget_ep_cmd \
           gadget/usb_gadget_connect gadget/usb_gadget_disconnect; do
    echo 1 > $T/events/$e/enable 2>/dev/null
  done
  echo 1 > $T/tracing_on
  echo "tracing on: $(cat $T/tracing_on), buffer $(cat $T/buffer_size_kb) kb"
  ;;
dump)
  cat $T/trace
  ;;
stop)
  echo 0 > $T/tracing_on
  for e in dwc3 gadget; do echo 0 > $T/events/$e/enable 2>/dev/null; done
  echo "tracing off"
  ;;
esac
